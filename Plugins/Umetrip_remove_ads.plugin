# 由 tools/ddgksf_merge.py 从墨鱼 QX 重写转换生成，请勿手改
# 上游：https://ddgksf2013.top/rewrite/UmetripAds.conf（V1.0.3，2026-10-05）

[Rewrite]
^https:\/\/oss\.umetrip\.com\/fs\/advert\/ reject-img

[Script]
http-response ^https:\/\/(?:sns|appmsg|home|umehome|opactivity|activity|umerp|flightstatus|umeflightstatus|startup|umestartup|user|umeuser|event)\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?.*)?$ script-path=https://raw.githubusercontent.com/BOBANDJOB/Loon/main/Scripts/ddgksf2013/umetrip.ads.js, requires-body=true, binary-body-mode=true, timeout=10, tag=航旅纵横去广告

[MITM]
hostname = sns.umetrip.com, appmsg.umetrip.com, home.umetrip.com, umehome.umetrip.com, opactivity.umetrip.com, activity.umetrip.com, umerp.umetrip.com, flightstatus.umetrip.com, umeflightstatus.umetrip.com, startup.umetrip.com, umestartup.umetrip.com, user.umetrip.com, umeuser.umetrip.com, event.umetrip.com, oss.umetrip.com
