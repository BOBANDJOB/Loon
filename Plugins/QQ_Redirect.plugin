#!name = QQ 链接解锁
#!desc = 跳过 QQ 内打开外链时的拦截与中转页，直接打开原链接
#!author = BOBANDJOB[https://github.com/BOBANDJOB]
#!icon = https://raw.githubusercontent.com/BOBANDJOB/Loon/main/Icons/app/qq.png
#!date = 2026-10-30 17:50

[Rewrite]
request if ${url} ~= /(^https:\/\/c\.pc\.qq\.com\/middlem\.html\?pfurl=)(http.*)(&pfuin=.*)/i as urlMatch then redirect(307, "${urlMatch.2}")
request if ${url} ~= /(^https:\/\/c\.pc\.qq\.com\/middlect\.html\?pfuin=.*&pfurl=)(http.*)(&gjsublevel=.*)/i as urlMatch then redirect(307, "${urlMatch.2}")
request if ${url} ~= /(^https:\/\/c\.pc\.qq\.com\/middlect\.html\?iscontinue=.*pfurl=)(http.*)(&pfuin=.*)/i as urlMatch then redirect(307, "${urlMatch.2}")
request if ${url} ~= /(^https:\/\/pingtas\.qq\.com\/webview\/pingd\?dm=c\.pc\.qq\.com&pvi=\d+&si=s\d+&url=\/middlem\.html\?pfurl%3d)(http.*)(%26pfuin%3d.*%26pfuin%3d.*)/i as urlMatch then redirect(307, "${urlMatch.2}")
request if ${url} ~= /(^https:\/\/cgi\.connect\.qq\.com\/qqconnectopen\/get_urlinfoForQQV2\?url=)(http.*)/i as urlMatch then redirect(307, "${urlMatch.2}")
request if ${url} ~= /(^https:\/\/c\.pc\.qq\.com\/index\.html\?pfurl=)(http.*)(&pfuin=.*)/i as urlMatch then redirect(307, "${urlMatch.2}")
request if ${url} ~= /(^https:\/\/c\.pc\.qq\.com\/ios\.html\?url=)(http.*)(&level=.*)/i as urlMatch then redirect(307, "${urlMatch.2}")
request if ${url} ~= /(^https:\/\/pingtas\.qq\.com\/webview\/pingd\?dm=c\.pc\.qq\.com&pvi=\d+&si=s\d+&url=\/ios\.html\?url%3d)(http.*)(%26level.*%26level.*)/i as urlMatch then redirect(307, "${urlMatch.2}")

[MITM]
hostname = pingtas.qq.com, c.pc.qq.com, cgi.connect.qq.com
