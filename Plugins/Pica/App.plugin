#!name = 哔咔 Pica
#!desc = 哔咔广告过滤、首页公告弹窗清理、横幅解析错误兜底与业务分流；业务域名沿用 US 策略组。
#!author = Winfred[https://github.com/BOBANDJOB]
#!homepage = https://github.com/BOBANDJOB/Loon/blob/main/Docs/Pica/App.md
#!icon = https://raw.githubusercontent.com/BOBANDJOB/Loon/main/Icons/app/pica.jpg
#!date = 2026-11-16 12:44

# 从本仓库 my-plugin.plugin 拆分，保留原有匹配条件、规则顺序和 US 分流。
# 请先添加并启用本插件，再更新 my-plugin；安装说明和历史规则盘点见 Docs/Pica/App.md。

[Rewrite]
^https:\/\/manhuapica\.com\/ad\/\?cat= reject-dict

[Script]
# 只处理已捕获的 GET /banners HTTP 500 JSON 解析错误，其他响应放行。
http-response ^https:\/\/api\.tipatipa\.xyz\/banners$ script-path=https://raw.githubusercontent.com/BOBANDJOB/Loon/main/Scripts/pica/banners.js, requires-body=true, timeout=10, tag=哔咔首页横幅错误兜底
# 首页推广弹窗来自公告第一页；此接口的公告列表也会一并清空。
http-response ^https:\/\/api\.tipatipa\.xyz\/announcements\?page=1$ script-path=https://raw.githubusercontent.com/BOBANDJOB/Loon/main/Scripts/pica/announcements.js, requires-body=true, timeout=10, tag=哔咔首页公告弹窗清理

[Rule]
# 广告域名必须排在 diwodiwo.xyz 的业务分流之前。
DOMAIN,ad-channel.wikawika.xyz,REJECT
DOMAIN,ad-channel.diwodiwo.xyz,REJECT
DOMAIN,ad-display.diwodiwo.xyz,REJECT
DOMAIN,manhuapica.com,US
DOMAIN,pica-web.wakamoment.tk,US
DOMAIN,api.tipatipa.xyz,US
DOMAIN-SUFFIX,diwodiwo.xyz,US
DOMAIN-SUFFIX,picacomic.com,US

[MitM]
hostname = manhuapica.com, api.tipatipa.xyz
